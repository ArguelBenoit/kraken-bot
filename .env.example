# Nécessaire uniquement en mode "live" (droits: Query Funds + Create & Modify Orders, PAS de retrait)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Accès depuis d'autres machines du réseau local : HOST=0.0.0.0 (défaut 127.0.0.1 = cette machine seulement)
# Mets alors un mot de passe : le site peut passer des ordres réels. Identifiant libre, seul le mot de passe compte.
HOST=127.0.0.1
APP_PASSWORD=

# Modèles (Bot IA et propositions du Trading) : une seule clé suffit, celle du fournisseur choisi dans l'interface.
# Chaque appel consomme des tokens (payant chez le fournisseur).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# Modèle local avec Ollama (sans clé, gratuit) : adresse du serveur Ollama et taille de contexte (tokens ; le défaut d'Ollama est trop petit pour le prompt du bot).
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
